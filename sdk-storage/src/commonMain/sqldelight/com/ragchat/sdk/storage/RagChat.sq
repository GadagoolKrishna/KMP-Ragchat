CREATE TABLE chunk_fts (
    chunk_id TEXT NOT NULL,
    scope_id TEXT NOT NULL,
    content TEXT NOT NULL
);

CREATE INDEX idx_chunk_fts_scope ON chunk_fts(scope_id);

CREATE TABLE collections (
    scope_id TEXT NOT NULL,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    embedding_model_id TEXT NOT NULL,
    embedding_model_version TEXT NOT NULL,
    embedding_dimensions INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    PRIMARY KEY (scope_id, id)
);

CREATE TABLE documents (
    scope_id TEXT NOT NULL,
    id TEXT NOT NULL,
    collection_id TEXT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    source_uri TEXT,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    created_at INTEGER NOT NULL,
    PRIMARY KEY (scope_id, id),
    FOREIGN KEY (scope_id, collection_id) REFERENCES collections(scope_id, id) ON DELETE CASCADE
);

CREATE INDEX idx_documents_collection ON documents(scope_id, collection_id);

CREATE TABLE chunks (
    scope_id TEXT NOT NULL,
    id TEXT NOT NULL,
    document_id TEXT NOT NULL,
    chunk_index INTEGER NOT NULL,
    content TEXT NOT NULL,
    token_count INTEGER NOT NULL,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    PRIMARY KEY (scope_id, id),
    FOREIGN KEY (scope_id, document_id) REFERENCES documents(scope_id, id) ON DELETE CASCADE
);

CREATE INDEX idx_chunks_document ON chunks(scope_id, document_id);

CREATE TABLE embeddings (
    scope_id TEXT NOT NULL,
    chunk_id TEXT NOT NULL,
    dimensions INTEGER NOT NULL,
    scale REAL NOT NULL,
    quantized_data BLOB NOT NULL,
    PRIMARY KEY (scope_id, chunk_id),
    FOREIGN KEY (scope_id, chunk_id) REFERENCES chunks(scope_id, id) ON DELETE CASCADE
);

CREATE TABLE ingestion_jobs (
    scope_id TEXT NOT NULL,
    id TEXT NOT NULL,
    document_id TEXT NOT NULL,
    status TEXT NOT NULL,
    progress REAL NOT NULL DEFAULT 0.0,
    error_message TEXT,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (scope_id, id)
);

CREATE TABLE audit_log (
    scope_id TEXT NOT NULL,
    event_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    event_hash TEXT NOT NULL,
    prev_hash TEXT,
    timestamp INTEGER NOT NULL,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    PRIMARY KEY (scope_id, event_id)
);

CREATE TABLE schema_meta (
    version INTEGER PRIMARY KEY NOT NULL,
    applied_at INTEGER NOT NULL
);

-- Queries for collections
insertCollection:
INSERT OR REPLACE INTO collections(scope_id, id, name, embedding_model_id, embedding_model_version, embedding_dimensions, created_at, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getCollection:
SELECT * FROM collections WHERE scope_id = ? AND id = ?;

listCollections:
SELECT * FROM collections WHERE scope_id = ?;

deleteCollection:
DELETE FROM collections WHERE scope_id = ? AND id = ?;

-- Queries for documents
insertDocument:
INSERT OR REPLACE INTO documents(scope_id, id, collection_id, title, content, source_uri, metadata_json, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getDocument:
SELECT * FROM documents WHERE scope_id = ? AND id = ?;

listDocuments:
SELECT * FROM documents WHERE scope_id = ? AND collection_id = ?;

deleteDocument:
DELETE FROM documents WHERE scope_id = ? AND id = ?;

-- Queries for chunks
insertChunk:
INSERT OR REPLACE INTO chunks(scope_id, id, document_id, chunk_index, content, token_count, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?);

getChunk:
SELECT * FROM chunks WHERE scope_id = ? AND id = ?;

listChunksByDocument:
SELECT * FROM chunks WHERE scope_id = ? AND document_id = ? ORDER BY chunk_index ASC;

deleteChunk:
DELETE FROM chunks WHERE scope_id = ? AND id = ?;

-- Queries for FTS index table
insertChunkFts:
INSERT INTO chunk_fts(chunk_id, scope_id, content)
VALUES (?, ?, ?);

deleteChunkFts:
DELETE FROM chunk_fts WHERE scope_id = ? AND chunk_id = ?;

deleteDocumentChunksFts:
DELETE FROM chunk_fts WHERE scope_id = ? AND chunk_id IN (SELECT id FROM chunks WHERE scope_id = ? AND document_id = ?);

searchFtsLike:
SELECT chunk_id
FROM chunk_fts
WHERE scope_id = ? AND content LIKE ('%' || ? || '%');

-- Queries for embeddings
insertEmbedding:
INSERT OR REPLACE INTO embeddings(scope_id, chunk_id, dimensions, scale, quantized_data)
VALUES (?, ?, ?, ?, ?);

getEmbedding:
SELECT * FROM embeddings WHERE scope_id = ? AND chunk_id = ?;

listEmbeddingsForCollection:
SELECT e.* FROM embeddings e
JOIN chunks c ON e.scope_id = c.scope_id AND e.chunk_id = c.id
JOIN documents d ON c.scope_id = d.scope_id AND c.document_id = d.id
WHERE e.scope_id = ? AND d.collection_id = ?;

deleteEmbedding:
DELETE FROM embeddings WHERE scope_id = ? AND chunk_id = ?;

-- Ingestion jobs
insertJob:
INSERT OR REPLACE INTO ingestion_jobs(scope_id, id, document_id, status, progress, error_message, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

getJob:
SELECT * FROM ingestion_jobs WHERE scope_id = ? AND id = ?;

listJobs:
SELECT * FROM ingestion_jobs WHERE scope_id = ? ORDER BY updated_at DESC;

-- Audit log
insertAuditLog:
INSERT INTO audit_log(scope_id, event_id, event_type, event_hash, prev_hash, timestamp, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?);

listAuditLog:
SELECT * FROM audit_log WHERE scope_id = ? ORDER BY timestamp ASC;

getLatestAuditLog:
SELECT * FROM audit_log WHERE scope_id = ? ORDER BY timestamp DESC LIMIT 1;

-- Schema meta
insertSchemaMeta:
INSERT OR REPLACE INTO schema_meta(version, applied_at)
VALUES (?, ?);

getSchemaMeta:
SELECT * FROM schema_meta ORDER BY version DESC LIMIT 1;

-- Full purge & shredding
purgeDocumentCascade:
DELETE FROM documents WHERE scope_id = ? AND id = ?;

clearScopeAll:
DELETE FROM collections WHERE scope_id = ?;

clearAuditScope:
DELETE FROM audit_log WHERE scope_id = ?;

clearJobsScope:
DELETE FROM ingestion_jobs WHERE scope_id = ?;

clearEntireDatabase:
DELETE FROM collections;
